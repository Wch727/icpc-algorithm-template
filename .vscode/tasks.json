{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe 生成活动文件",
      "command": "C:/mingw64/bin/g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-std=c++2c",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "-Wall",
"-Wextra",
"-lm",
"-O2",
"-static",
"-Wl,--stack=8388608"
      ],
      "options": {
        "cwd": "C:/mingw64/bin"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "编译器: C:/mingw64/bin/g++.exe"
    }
  ]
}
