# 只发布算法库本体：旧练习模板（GBK 编码）、课件、编译产物都不进仓库
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/ICPC算法手册.tex
!/风格说明.md
!/自检.ps1
!/01-基础与技巧/
!/02-数据结构/
!/03-字符串/
!/04-图论/
!/05-数学/
!/06-动态规划/
!/07-搜索/
!/08-计算几何/
!/09-其他/
!/.vscode/
!/_台账/
!/索引.md
!/结论速查.md
!/结论速查/
!/测试/
!/说明/
!/看板.ps1

# 排版中间产物与 PDF 不入库（PDF 是本地打印用）
/build/

# 台账里的中间产物不入库
/_台账/shard_*.csv
/_台账/_tmp*
/_台账/_raw*
/_台账/_progress*
/_台账/tag_dropdown.csv
/_台账/拆分模板与测试.py
/_台账/修正拆分.py
/_台账/codex*日志.txt
/_台账/给Codex*.md
/_台账/Codex交接文档.md
/_台账/给Claude*.md

# 会话状态（不入库）
/控制台.md
/_台账/指令.md

# 编译产物
bin/
*.exe
*.o
*.obj
*.out

# Python 缓存
__pycache__/
*.py[cod]
